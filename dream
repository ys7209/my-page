    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background: linear-gradient(180deg, #0f172a 0%, #0369a1 40%, #0891b2 80%, #164e63 100%);
            min-height: 100vh;
            overflow-x: hidden;
            color: #f0fdf4;
        }

        .font-gaegu {
            font-family: 'Gaegu', cursive;
        }

        /* custom sparkler canvas */
        #sparkle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 9999;
        }

        /* 3D Card Flip Styling */
        .perspective-1000 {
            perspective: 1000px;
        }

        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
            transform-style: preserve-3d;
            cursor: pointer;
        }

        .flip-card.flipped .flip-card-inner {
            transform: rotateY(180deg);
        }

        .flip-card-front, .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.3), 0 8px 10px -6px rgba(2, 132, 199, 0.2);
        }

        .flip-card-back {
            transform: rotateY(180deg);
        }

        /* Floating Bubbles Animation Background */
        @keyframes float-bubble {
            0% { transform: translateY(0) scale(0.8); opacity: 0; }
            20% { opacity: 0.7; }
            80% { opacity: 0.8; }
            100% { transform: translateY(-105vh) scale(1.2); opacity: 0; }
        }

        .bg-bubble {
            position: absolute;
            pointer-events: none;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.8), rgba(186, 230, 253, 0.3));
            box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.6);
            animation: float-bubble linear infinite;
        }

        /* 글자 통통 튀는 애니메이션 (Bouncing text) */
        @keyframes bounce-letter {
            0%, 100% {
                transform: translateY(0) scale(1);
            }
            50% {
                transform: translateY(-18px) scale(1.15) rotate(4deg);
                color: #38bdf8;
                text-shadow: 0 0 15px rgba(56, 189, 248, 0.8);
            }
        }

        .bounce-char {
            display: inline-block;
            animation: bounce-letter 1.8s infinite ease-in-out;
            cursor: pointer;
        }

        .bounce-char:nth-child(1) { animation-delay: 0.0s; }
        .bounce-char:nth-child(2) { animation-delay: 0.2s; }
        .bounce-char:nth-child(3) { animation-delay: 0.4s; }

        /* Floating mascot */
        @keyframes swim-slow {
            0%, 100% { transform: translateY(0px) rotate(-3deg); }
            50% { transform: translateY(-14px) rotate(3deg); }
        }

        .animate-swim {
            animation: swim-slow 3.5s ease-in-out infinite;
        }

        /* Custom Bounce */
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            80% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(1); }
        }

        .pop-in {
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
    </style>
